;;; lispm-kernel-desktop-test.el --- Opt-in integration against desktop -*- lexical-binding: t; -*-
(require 'lispm-kernel-desktop)
(require 'lispm-desktop-agent-codex)
(require 'lispm-desktop-agent-claude)
(require 'lispm-desktop-term)

(ert-deftest lispm-kernel-desktop-provider-is-eventually-equivalent-and-reversible ()
  (let* ((directory (make-temp-file "lispm-desktop-integration-" t))
         (lispm-desktop-agent-codex-sessions-directory directory)
         (lispm-desktop-agent-codex-index-file (expand-file-name "missing-index.jsonl" directory))
         baseline result)
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "rollout-test.jsonl" directory)
            (insert "{\"type\":\"session_meta\",\"payload\":{\"id\":\"id\",\"cwd\":\"/test\",\"timestamp\":\"2026-10-21T00:00:00Z\"}}\n"
                    "{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"same title\"}}\n"))
          (setq baseline (lispm-desktop-agent-codex-sessions))
          (lispm-kernel-desktop-mode 1)
          (should-not (lispm-desktop-agent-codex-sessions))
          (lispm-kernel-test--finish lispm-kernel-desktop--runtime)
          (setq result (lispm-desktop-agent-codex-sessions))
          (should (= (length result) 1))
          (dolist (key '(:agent :id :cwd :title :started :file :time))
            (should (equal (plist-get (car result) key) (plist-get (car baseline) key))))
          ;; A fresh snapshot does not trigger an endless scan/repaint loop.
          (should (= (hash-table-count (lispm-kernel-runtime-callbacks lispm-kernel-desktop--runtime)) 0))
          (lispm-kernel-desktop-mode -1)
          (should-not (advice-member-p #'lispm-kernel-desktop--codex 'lispm-desktop-agent-codex-sessions))
          (should (equal (lispm-desktop-agent-codex-sessions) baseline)))
      (lispm-kernel-desktop-mode -1)
      (delete-directory directory t))))

(ert-deftest lispm-kernel-desktop-explicit-refresh-invalidates-native-generation ()
  (let ((directory (make-temp-file "lispm-refresh-" t)))
    (unwind-protect
        (progn
          (lispm-kernel-desktop-mode 1)
          (puthash 'codex '(:sessions ((:id "old")) :generation 0 :time 1 :request 42)
                   lispm-kernel-desktop--cache)
          (lispm-kernel-desktop-invalidate)
          (let ((entry (gethash 'codex lispm-kernel-desktop--cache)))
            (should (= (plist-get entry :generation) 1))
            (should-not (plist-get entry :request))
            (should-not (plist-get entry :time))
            (should (equal (plist-get entry :sessions) '((:id "old"))))))
      (lispm-kernel-desktop-mode -1)
      (delete-directory directory t))))

(ert-deftest lispm-kernel-desktop-reenable-retains-runtime ()
  (unwind-protect
      (progn
        (lispm-kernel-desktop-mode 1)
        (let ((runtime lispm-kernel-desktop--runtime))
          (lispm-kernel-desktop-mode 1)
          (should (eq runtime lispm-kernel-desktop--runtime))))
    (lispm-kernel-desktop-mode -1)))

(ert-deftest lispm-kernel-desktop-claude-result-matches-current-parser ()
  (let* ((directory (make-temp-file "lispm-claude-parity-" t))
         (lispm-desktop-agent-claude-projects-directory directory)
         baseline result)
    (unwind-protect
        (progn
          (make-directory (expand-file-name "project/session" directory) t)
          (with-temp-file (expand-file-name "project/session.jsonl" directory)
            (insert "{\"type\":\"user\",\"cwd\":\"/project\",\"isMeta\":true,\"message\":{\"content\":\"ignore me\"}}\n"
                    "{\"type\":\"user\",\"cwd\":\"/project\",\"message\":{\"content\":[{\"text\":\"hello\"}]}}\n"
                    "{\"type\":\"summary\",\"summary\":\"summary title\"}\n"))
          (with-temp-file (expand-file-name "project/session/custom-title.json" directory)
            (insert "{\"customTitle\":\"overridden title\"}"))
          (setq baseline (lispm-desktop-agent-claude-sessions))
          (lispm-kernel-desktop-mode 1)
          (lispm-desktop-agent-claude-sessions)
          (lispm-kernel-test--finish lispm-kernel-desktop--runtime)
          (setq result (lispm-desktop-agent-claude-sessions))
          (should (= (length result) 1))
          (dolist (key '(:agent :id :cwd :title :file :time))
            (should (equal (plist-get (car result) key) (plist-get (car baseline) key)))))
      (lispm-kernel-desktop-mode -1)
      (delete-directory directory t))))

(ert-deftest lispm-kernel-broker-terminal-first-and-shared-budget ()
  (let* ((runtime (lispm-kernel-create))
         (lispm-kernel-broker--runtime runtime)
         (lispm-kernel-broker--terminal-due 0)
         (lispm-kernel-broker--kernel-due 0)
         (lispm-kernel-broker--timer nil)
         (clock 0.0) order observed)
    (unwind-protect
        (cl-letf (((symbol-function 'lispm-kernel-module-monotonic) (lambda () clock))
                  ((symbol-function 'input-pending-p) (lambda () nil))
                  ((symbol-function 'lispm-desktop-term--tick)
                   (lambda () (push 'terminal order) (setq clock 0.006)))
                  ((symbol-function 'lispm-kernel-dispatch)
                   (lambda (_) (push 'kernel order) (setq observed lispm-kernel-slice-seconds))))
          (lispm-kernel-broker--tick)
          (should (equal (nreverse order) '(terminal kernel)))
          (should (< (abs (- observed 0.002)) 0.00001))
          (should-not lispm-kernel-broker--timer))
      (lispm-kernel-shutdown runtime))))

(ert-deftest lispm-kernel-broker-overrun-defers-kernel-without-dropping-work ()
  (let* ((runtime (lispm-kernel-create))
         (lispm-kernel-broker--runtime runtime)
         (lispm-kernel-broker--terminal-due 0)
         (lispm-kernel-broker--kernel-due 0)
         (lispm-kernel-broker--timer nil)
         (lispm-kernel-broker-overruns 0)
         (clock 0.0) called)
    (unwind-protect
        (cl-letf (((symbol-function 'lispm-kernel-module-monotonic) (lambda () clock))
                  ((symbol-function 'input-pending-p) (lambda () nil))
                  ((symbol-function 'lispm-desktop-term--tick) (lambda () (setq clock 0.02)))
                  ((symbol-function 'lispm-kernel-dispatch) (lambda (_) (setq called t))))
          (lispm-kernel-broker--tick)
          (should-not called)
          (should (= lispm-kernel-broker--kernel-due 0))
          (should lispm-kernel-broker--timer)
          (should (= lispm-kernel-broker-overruns 1)))
      (when lispm-kernel-broker--timer (cancel-timer lispm-kernel-broker--timer))
      (lispm-kernel-shutdown runtime))))

